#!/usr/bin/env bash
# Blip `message_hook=` entry point. Blip runs this with no arguments for each
# new inbound message: the body arrives on stdin, metadata in BLIP_HOOK_* env.

set -euo pipefail

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}"
  local source_dir link_target

  while [[ -L "$source_path" ]]; do
    source_dir=$(cd -P -- "$(dirname -- "$source_path")" && pwd)
    link_target=$(readlink -- "$source_path")
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done

  cd -P -- "$(dirname -- "$source_path")" && pwd
}

script_dir=$(resolve_script_dir)
exec "$script_dir/oma2fa" blip-hook "$@"
